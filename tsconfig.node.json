{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Alias */
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@editor/*": ["src/modules/editor/*"],
      "@templates/*": ["src/modules/templates/*"],
      "@mngRecipients/*": ["src/modules/mngRecipients/*"],
      "@group/*": ["src/modules/group/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
